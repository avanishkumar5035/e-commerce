NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=your_admin_email@example.com
# Put a bcrypt hash of your admin password here (use: node hashPassword.js "your_password")
ADMIN_PASSWORD_HASH=$2b$10$exampleHashGeneratedByBcrypt1234567890abcdefghijklm

# Gemini API configuration for smart Indian pincode & locality address resolution
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Real Email Delivery via Google Gmail / SMTP
# To generate a Gmail App Password: Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
FROM_NAME="ShopSphere Marketo"
